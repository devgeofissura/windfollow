digraph "wireviz_schematic" {
// Layout organizado gerado a partir de YAML WireViz — conexoes intactas
	graph [bgcolor="#ffffff" fontname="Arial" nodesep="0.55" rankdir=LR ranksep="1.45" splines=spline]
