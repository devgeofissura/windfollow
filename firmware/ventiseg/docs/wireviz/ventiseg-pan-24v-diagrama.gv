 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1">
   <tr><td><font point-size="9">Fonte auxiliar de 5 V</font></td></tr>
   <tr><td><font point-size="8">somente lado HV do conversor</font></td></tr>
  </table>
 </td></tr>
 <tr><td>
