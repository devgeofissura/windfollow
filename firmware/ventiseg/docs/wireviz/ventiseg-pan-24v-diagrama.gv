> fillcolor="#FFFFFF" color="#334155" shape=box style="filled"]
	__NC_J_DM556D_5 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><font point-size="8"><b>SEM LIGAÇÃO</b></font></td></tr><tr><td><font point-size="8">ENA+_NC</font></td></tr></table>> fillcolor="#f8fafc" color="#94a3b8" shape=box style="filled,dashed"]
