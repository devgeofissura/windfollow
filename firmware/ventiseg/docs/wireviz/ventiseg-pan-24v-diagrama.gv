J_AVISOS [shape=box,style=filled,fillcolor="#fff2cc",color="#bf9000",fontname="Arial",fontsize=10,label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff2cc"><TR><TD BGCOLOR="#ffe699"><B>AVISOS DE SEGURANCA - LEIA ANTES DE ENERGIZAR</B></TD></TR><TR><TD ALIGN="LEFT">1) NUNCA ligar GPIO 3,3 V direto em PUL+ ou DIR+</TD></TR><TR><TD ALIGN="LEFT">2) Usar OBRIGATORIAMENTE o conversor de nivel 3,3 V para 5 V</TD></TR><TR><TD ALIGN="LEFT">3) Manter VENTISEG_ENABLE_GPIO=0 ate fechar P1-P5</TD></TR><TR><TD ALIGN="LEFT">4) Primeiro teste com o motor DESACOPLADO do duto</TD></TR><TR><TD ALIGN="LEFT">5) Conferir os oito pares do motor com OHMIMETRO</TD></TR><TR><TD ALIGN="LEFT">Pendencias: NAO CONFIRMADO — verificar antes de energizar</TD></TR></TABLE>>];}
