digraph "wireviz_schematic" {
// Layout organizado gerado a partir de YAML WireViz — conexoes intactas
	graph [bgcolor="#ffffff" fontname="Arial" nodesep="0.55" rankdir=LR ranksep="1.45" splines=spline]
	node [fontname="Arial" fontsize="10" margin="0.12,0.08" shape=box style=filled]
	edge [arrowsize="0.7" fontname="Arial" fontsize="8" penwidth="2"]
	{ rank=same; J_SIMCAM; __LEGEND; __WARNINGS; }
	J_SIMCAM -> __LEGEND [style="invis"]
	__LEGEND -> __WARNINGS [style="invis"]
	{ rank=same; J_5V; J_LEVEL; }
	J_5V -> J_LEVEL [style="invis"]
	{ rank=same; J_PSU_24V; J_DM556D; __NC_J_DM556D_5; __NC_J_DM556D_6; }
	J_PSU_24V -> J_DM556D [style="invis"]
	J_DM556D -> __NC_J_DM556D_5 [style="invis"]
	__NC_J_DM556D_5 -> __NC_J_DM556D_6 [style="invis"]
	{ rank=same; J_M_PAN; }
	{ rank=same; J_REF_GND; }
	J_SIMCAM [label=<
<table border="0" cellborder="0" cellspacing="0" cellpadding="2">
 <tr><td bgcolor="#9dc3e6"><b>J_SIMCAM</b></td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1">
   <tr><td><font point-size="9">ESP32-S3 LILYGO T-SIMCAM</font></td></tr>
   <tr><td><font point-size="8">J_GPIO_LIVRES · 6 pinos · lógica 3,3 V</font></td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="1" cellborder="1" cellspacing="0" cellpadding="2">
   <tr><td port="p1" align="left">1 · IO3_STEP</td></tr>
   <tr><td port="p2" align="left">2 · IO46_RESERVADO</td></tr>
   <tr><td port="p3" align="left">3 · IO45_RESERVADO</td></tr>
   <tr><td port="p4" align="left">4 · IO21_DIR</td></tr>
   <tr><td port="p5" align="left">5 · GND</td></tr>
   <tr><td port="p6" align="left">6 · 3V3_LOGICA</td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr>
   <td><font point-size="8">STEP=IO3 (ADC de bateria, sem bateria no projeto); DIR=IO21. IO45/IO46 RESERVADOS: pinos de strapping, nao puxar HIGH no boot. Inversao IO3/IO21 foi typo; serigrafia prevalece. NUNCA aplica…</font></td>
  </tr></table>
 </td></tr>
</table>
> fillcolor="#FFFFFF" color="#334155" shape=box style="filled"]
	J_LEVEL [label=<
<table border="0" cellborder="0" cellspacing="0" cellpadding="2">
 <tr><td bgcolor="#f8cbad"><b>J_LEVEL</b></td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1">
   <tr><td><font point-size="9">Conversor de nivel bidirecional 3,3 V / 5 V</font></td></tr>
   <tr><td><font point-size="8">2 canais · obrigatorio · opto exige alto &gt; 3,5 V</font></td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="1" cellborder="1" cellspacing="0" cellpadding="2">
   <tr><td port="p1" align="left">1 · STEP_LV</td></tr>
   <tr><td port="p2" align="left">2 · DIR_LV</td></tr>
   <tr><td port="p3" align="left">3 · VCC_3V3</td></tr>
   <tr><td port="p4" align="left">4 · GND_LV</td></tr>
   <tr><td port="p5" align="left">5 · STEP_HV</td></tr>
   <tr><td port="p6" align="left">6 · DIR_HV</td></tr>
   <tr><td port="p7" align="left">7 · VCC_5V</td></tr>
   <tr><td port="p8" align="left">8 · GND_HV</td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr>
   <td><font point-size="8">Lado LV: IO3/IO21/3V3/GND da SIMCAM. Lado HV: PUL+/DIR+ do DM556D a 5 V. VCC_5V: origem NAO CONFIRMADO — verificar antes de energizar. Corrente do opto e pulso minimo: NAO CONFIRMADO — veri…</font></td>
  </tr></table>
 </td></tr>
</table>
