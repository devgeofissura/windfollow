	J_LEVEL:p6:e -> J_DM556D:p3:w [color="#8000ff" penwidth="2.2" arrowsize="0.7" arrowhead="vee" xlabel="W_DIR_5V:1 · DIR_5V" fontcolor="#111827" fontsize="8" tooltip="DIR 5 V — DIR_HV -> DIR+ | W_DIR_5V:1 · DIR_5V"]
	J_SIMCAM:p5:e -> J_DM556D:p2:w [color="#000000" penwidth="2.2" arrowsize="0.7" arrowhead="vee" xlabel="W_PUL_N:1 · PUL_N" fontcolor="#111827" fontsize="8" tooltip="GND SIMCAM -> PUL- (catodo comum) | W_PUL_N:1 · PUL_N"]
	J_SIMCAM:p5:e -> J_DM556D:p4:w [color="#000000" penwidth="2.2" arrowsize="0.7" arrowhead="vee" xlabel="W_DIR_N:1 · DIR_N" fontcolor="#111827" fontsize="8" tooltip="GND SIMCAM -> DIR- (catodo comum) | W_DIR_N:1 · DIR_N"]
	J_PSU_24V:p1:n -> J_DM556D:p7:s [color="#ff0000" penwidth="2.2" arrowsize="0.7" arrowhead="vee" constraint="false" xlabel="W_PSU_P:1 · MAIS_24V" fontcolor="#111827" fontsize="8" tooltip="Fonte 24-36 VDC -> VCC do DM556D | W_PSU_P:1 · MAIS_24V"]
