	J_DM556D -> __NC_J_DM556D_5 [style="invis"]
	__NC_J_DM556D_5 -> __NC_J_DM556D_6 [style="invis"]
	{ rank=same; J_M_PAN; }
	{ rank=same; J_REF_GND; }
	J_SIMCAM [label=<
<table border="0" cellborder="0" cellspacing="0" cellpadding="2">
 <tr><td bgcolor="#9dc3e6"><b>J_SIMCAM</b></td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1">
   <tr><td><font point-size="9">ESP32-S3 LILYGO T-SIMCAM</font></td></tr>
   <tr><td><font point-size="8">J_GPIO_LIVRES · 6 pinos · lógica 3,3 V</font></td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="1" cellborder="1" cellspacing="0" cellpadding="2">
   <tr><td port="p1" align="left">1 · IO3_STEP</td></tr>
   <tr><td port="p2" align="left">2 · IO46_RESERVADO</td></tr>
   <tr><td port="p3" align="left">3 · IO45_RESERVADO</td></tr>
   <tr><td port="p4" align="left">4 · IO21_DIR</td></tr>
   <tr><td port="p5" align="left">5 · GND</td></tr>
   <tr><td port="p6" align="left">6 · 3V3_LOGICA</td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1"><tr>
   <td><font point-size="8">STEP=IO3 (ADC de bateria, sem bateria no projeto); DIR=IO21. IO45/IO46 RESERVADOS: pinos de strapping, nao puxar HIGH no boot. Inversao IO3/IO21 foi typo; serigrafia prevalece. NUNCA aplica…</font></td>
  </tr></table>
 </td></tr>
</table>
> fillcolor="#FFFFFF" color="#334155" shape=box style="filled"]
	J_ULN_IN [label=<
<table border="0" cellborder="0" cellspacing="0" cellpadding="2">
 <tr><td bgcolor="#c9a5e8"><b>J_ULN_IN</b></td></tr>
 <tr><td>
  <table border="0" cellborder="0" cellspacing="0" cellpadding="1">
   <tr><td><font point-size="9">Modulo ULN2003A — interface de nivel, entradas (In1..In…</font></td></tr>
   <tr><td><font point-size="8">In1..In7 · Darlington 500 mA por canal</font></td></tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="1" cellborder="1" cellspacing="0" cellpadding="2">
   <tr><td port="p1" align="left">1 · IN1_STEP</td></tr>
   <tr><td port="p2" align="left">2 · IN2_DIR</td></tr>
