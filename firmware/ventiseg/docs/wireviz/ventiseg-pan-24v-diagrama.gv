 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">ESP32-S3 LILYGO T-SIMCAM</td>
   <td balign="left">J_GPIO_LIVRES · 6 pinos · lógica 3,3 V</td>
   <td balign="left">6-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
